{
  "catalog_path": "catalog",
  "adapters": {
    "reconciliation": {
      "enabled_systems": ["jira", "git", "github", "jenkins", "argocd", "tempo"],
      "http_timeout_seconds": 10,
      "process_timeout_seconds": 15,
      "repositories_root": "repos",
      "jenkins_max_builds": 5
    },
    "jenkins": {
      "timeout_seconds": 10,
      "max_builds": 5,
      "required_plugins": [],
      "credential_domain": "_"
    },
    "automox": {
      "timeout_seconds": 10,
      "api_base_url": "https://console.automox.com/api",
      "org": "000000",
      "domain": "example.internal",
      "default_profile": "default",
      "devices_limit": 500,
      "groups_limit": 500,
      "policies_limit": 500
    }
  },
  "toolchain": {
    "groovy": {
      "default": "/opt/homebrew/bin/groovy"
    }
  }
}
