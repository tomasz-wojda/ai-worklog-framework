#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$SOURCE_DIR/$SOURCE" ;;
  esac
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
SRC_DIR="$ROOT/groovy/src/main/groovy"
BUILD_DIR="$ROOT/groovy/build"
CLASSPATH_FILE="$BUILD_DIR/ai-worklog.classpath"
AOT_CACHE="$BUILD_DIR/ai-worklog.aot"
STAMP_FILE="$BUILD_DIR/ai-worklog-stamp"

export AI_WORKLOG_FRAMEWORK_ROOT="$ROOT"

if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_EXECUTABLE="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
  JAVA_EXECUTABLE="java"
else
  JAVA_EXECUTABLE=""
fi

compiled_classpath() {
  local classpath entry
  [ -f "$CLASSPATH_FILE" ] && [ -f "$STAMP_FILE" ] || return 1
  [ -z "$(find "$SRC_DIR" -name '*.groovy' -newer "$STAMP_FILE" -print -quit)" ] || return 1
  IFS= read -r classpath < "$CLASSPATH_FILE" || return 1
  IFS=: read -r -a entries <<< "$classpath"
  for entry in "${entries[@]}"; do
    [ -f "$entry" ] || return 1
  done
  printf '%s' "$classpath"
}

if [ -n "$JAVA_EXECUTABLE" ] && CLASSPATH="$(compiled_classpath)"; then
  JVM_OPTIONS=(-XX:TieredStopAtLevel=1 -XX:+UseSerialGC --enable-native-access=ALL-UNNAMED)
  if [ -f "$AOT_CACHE" ]; then
    JVM_OPTIONS+=(-XX:+IgnoreUnrecognizedVMOptions -XX:AOTCache="$AOT_CACHE" -Xlog:aot=off -Xlog:cds=off)
  fi
  exec "$JAVA_EXECUTABLE" "${JVM_OPTIONS[@]}" \
    -cp "$CLASSPATH" \
    ai.worklog.framework.Main \
    "$@"
fi

GROOVY_EXECUTABLE="${AI_WORKLOG_GROOVY:-groovy}"

if ! command -v "$GROOVY_EXECUTABLE" >/dev/null 2>&1; then
  echo "Groovy is required for the default runtime. Use --runtime python as fallback." >&2
  exit 2
fi

exec "$GROOVY_EXECUTABLE" \
  -cp "$SRC_DIR" \
  "$SRC_DIR/ai/worklog/framework/Main.groovy" \
  "$@"
