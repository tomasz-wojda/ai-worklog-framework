#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$SOURCE_DIR/$SOURCE" ;;
  esac
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
RUNTIME=""
ARGS=()
SAW_COMMAND=0
KNOWN_COMMANDS=" workspace config catalog ticket state preflight reconcile service day delivery closeout diag toolchain help "

while (($#)); do
  if [[ $SAW_COMMAND -eq 0 ]]; then
    case "$1" in
      --runtime)
        if (($# < 2)); then
          echo "Missing value for --runtime" >&2
          exit 1
        fi
        RUNTIME="$2"
        shift 2
        continue
        ;;
      --runtime=*)
        RUNTIME="${1#*=}"
        shift
        continue
        ;;
    esac
  fi
  if [[ $SAW_COMMAND -eq 0 && "$KNOWN_COMMANDS" == *" $1 "* ]]; then
    SAW_COMMAND=1
  fi
  ARGS+=("$1")
  shift
done

COMMAND=""
for ((index = 0; index < ${#ARGS[@]}; index++)); do
  case "${ARGS[index]}" in
    --workspace|--workspace-name|-w)
      ((index += 1))
      ;;
    --workspace=*|--workspace-name=*|--help|-h|--json|--version)
      ;;
    *)
      COMMAND="${ARGS[index]}"
      break
      ;;
  esac
done

if [[ "$COMMAND" == "jenkins" ]]; then
  echo "Command moved: use 'ai-worklog service jenkins ...'" >&2
  exit 1
fi

if [[ -z "$RUNTIME" && -n "${AI_WORKLOG_RUNTIME:-}" ]]; then
  RUNTIME="$AI_WORKLOG_RUNTIME"
fi

_read_config_runtime_line() {
  local matches
  [[ "$(grep -c '"runtime"' "$CONFIG_FILE")" == 1 ]] || return 1
  matches="$(sed -n -E 's/^[[:space:]]*"runtime"[[:space:]]*:[[:space:]]*"(groovy|python)"[[:space:]]*,?[[:space:]]*$/\1/p' "$CONFIG_FILE")"
  [[ "$matches" == groovy || "$matches" == python ]] || return 1
  RUNTIME="$matches"
}

_read_config_runtime() {
  local runtime=""
  local python="${AI_WORKLOG_PYTHON:-python3}"

  if _read_config_runtime_line; then
    return 0
  fi

  if [[ -x "$ROOT/.venv/bin/python" ]]; then
    python="$ROOT/.venv/bin/python"
  elif [[ -x "$ROOT/python/.venv/bin/python" ]]; then
    python="$ROOT/python/.venv/bin/python"
  fi

  if command -v "$python" >/dev/null 2>&1; then
    if runtime="$(PYTHONPATH="$ROOT/python/src${PYTHONPATH:+:$PYTHONPATH}" "$python" -c 'from ai_worklog_framework.global_config import load_global_config; print(load_global_config()["runtime"])' 2>/dev/null)"; then
      RUNTIME="$runtime"
      return 0
    fi
  fi

  if command -v groovy >/dev/null 2>&1; then
    if runtime="$(AI_WORKLOG_FRAMEWORK_ROOT="$ROOT" groovy -cp "$ROOT/groovy/src/main/groovy" -e 'import ai.worklog.framework.core.GlobalConfig; print GlobalConfig.load().runtime' 2>/dev/null)"; then
      RUNTIME="$runtime"
      return 0
    fi
  fi

  return 1
}

if [[ -z "$RUNTIME" ]]; then
  CONFIG_HOME="${AI_WORKLOG_HOME:-$HOME/.ai-worklog}"
  case "$CONFIG_HOME" in
    "~") CONFIG_HOME="$HOME" ;;
    "~/"*) CONFIG_HOME="$HOME/${CONFIG_HOME#\~/}" ;;
  esac
  CONFIG_FILE="$CONFIG_HOME/config.json"
  if [[ -f "$CONFIG_FILE" ]]; then
    if ! _read_config_runtime; then
      echo "Malformed global configuration: $CONFIG_FILE" >&2
      exit 1
    fi
  else
    RUNTIME="groovy"
  fi
fi

_dispatch_runtime() {
  local launcher="$1"
  if ((${#ARGS[@]})); then
    exec "$launcher" "${ARGS[@]}"
  fi
  exec "$launcher"
}

case "$RUNTIME" in
  groovy)
    _dispatch_runtime "$ROOT/bin/ai-worklog-groovy"
    ;;
  python)
    _dispatch_runtime "$ROOT/bin/ai-worklog-python"
    ;;
  *)
    echo "Unsupported runtime: $RUNTIME (expected groovy or python)" >&2
    exit 1
    ;;
esac
