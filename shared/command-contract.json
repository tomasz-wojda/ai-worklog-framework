      "name": "day",
      "description": "Daily routines",
      "kind": "command",
      "subcommands": []
    },
    {
      "name": "delivery",
      "description": "Delivery state tracking",
      "kind": "command",
      "subcommands": []
    },
    {
      "name": "closeout",
      "description": "Close-out and handover",
      "kind": "command",
      "subcommands": []
    },
    {
      "name": "diag",
      "description": "Diagnostic packs",
      "kind": "command",
      "subcommands": []
    },
    {
      "name": "toolchain",
      "description": "Python/Java/Groovy detection and routing",
      "kind": "command",
      "subcommands": []
    },
    {
      "name": "help",
      "description": "Command usage and machine-readable descriptions",
      "kind": "command",
      "subcommands": []
    }
  ]
}
