{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workspace Configuration",
  "type": "object",
  "properties": {
    "catalog_path": {
      "type": "string",
      "description": "Relative or absolute path to the service catalog directory"
    },
    "interface_path": {
      "type": ["string", "null"],
      "description": "Relative or absolute path to the service interface symlink hub"
    },
    "services": {
      "type": "object",
      "description": "Per-service adapter overrides",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "path": { "type": "string" },
          "properties_file": { "type": "string" }
        }
      }
    },
    "adapters": {
      "type": "object",
      "description": "Adapter-specific configuration",
      "additionalProperties": true
    },
    "preflight": {
      "type": "object",
      "properties": {
        "required_binaries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optional_binaries": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "description": "Multi-version Python/Java/Groovy routing for legacy workspace tools",
      "properties": {
        "java": {
          "type": "object",
          "description": "Java major version to JAVA_HOME path (e.g. \"17\", \"25\")",
          "additionalProperties": { "type": "string" }
        },
        "groovy": {
          "type": "object",
          "description": "Groovy major version or 'default' to executable path",
          "additionalProperties": { "type": "string" }
        },
        "tools": {
          "type": "object",
          "description": "Per-tool overrides for required java/groovy majors",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "java": { "type": "integer" },
              "groovy": { "type": "integer" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
