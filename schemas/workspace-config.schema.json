{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workspace Configuration",
  "type": "object",
  "properties": {
    "catalog_path": {
      "type": "string",
      "description": "Relative or absolute path to the service catalog directory"
    },
    "interface_path": {
      "type": ["string", "null"],
      "deprecated": true,
      "description": "Deprecated compatibility field; integrations are always resolved from the workspace-root integrations directory"
    },
    "services": {
      "type": "object",
      "description": "Per-service adapter overrides",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "path": { "type": "string" },
          "properties_file": { "type": "string" }
        }
      }
    },
    "adapters": {
      "type": "object",
      "description": "Adapter-specific configuration",
      "properties": {
        "reconciliation": {
          "type": "object",
          "properties": {
            "enabled_systems": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["jira", "git", "github", "jenkins", "argocd", "tempo"]
              },
              "uniqueItems": true
            },
            "http_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
            "process_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
            "repositories_root": {"type": "string"},
            "jenkins_max_builds": {"type": "integer", "minimum": 1, "maximum": 100}
          },
          "additionalProperties": false
        },
        "jenkins": {
          "type": "object",
          "properties": {
            "ai_vault_root": {"type": "string"},
            "syntax_check_script": {"type": "string"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
            "max_builds": {"type": "integer", "minimum": 1, "maximum": 100},
            "required_plugins": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            },
            "credential_domain": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "preflight": {
      "type": "object",
      "properties": {
        "required_binaries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optional_binaries": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "description": "Runtime discovery configuration",
      "properties": {
        "groovy": {
          "type": "object",
          "description": "Groovy major version or 'default' to executable path",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
