{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Automox Operator Report",
  "type": "object",
  "required": ["operation", "fetched_at", "status", "items"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "profiles",
        "auth-test",
        "orgs",
        "groups",
        "group",
        "devices",
        "device",
        "device-packages",
        "activity",
        "patch-summary",
        "policies",
        "policy",
        "policy-stats",
        "device-queue",
        "policy-run",
        "worklet-create",
        "policy-delete",
        "device-move",
        "policy-add-group"
      ]
    },
    "fetched_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["ready", "degraded", "blocked", "error", "unknown"]
    },
    "profile": {"type": "string"},
    "org": {"type": "string"},
    "message": {"type": "string"},
    "query": {"type": "string"},
    "device": {"type": "string"},
    "group": {"type": "string"},
    "policy": {"type": "string"},
    "dry_run": {"type": "boolean"},
    "applied": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "filters": {"type": "object"},
    "totals": {"type": "object"},
    "schedule": {
      "type": "object",
      "properties": {
        "days": {"type": "array", "items": {"type": "string"}},
        "weeks_of_month": {"type": "array", "items": {"type": "integer"}},
        "months": {"type": "array", "items": {"type": "string"}},
        "schedule_days": {"type": "integer"},
        "schedule_weeks_of_month": {"type": "integer"},
        "schedule_months": {"type": "integer"},
        "time": {"type": "string"},
        "use_scheduled_timezone": {"type": "boolean"},
        "next_remediation_reliable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "applied": {"type": "boolean"},
        "dry_run": {"type": "boolean"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "steps": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
