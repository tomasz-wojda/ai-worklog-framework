{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Worklog Catalog List Report",
  "type": "object",
  "required": ["operation", "status", "count", "items"],
  "properties": {
    "operation": {"type": "string", "const": "list"},
    "status": {"type": "string", "const": "ok"},
    "count": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "owners"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "owners": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
