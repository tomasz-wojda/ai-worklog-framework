{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "New Relic Dashboard Definition",
  "oneOf": [
    {"$ref": "#/definitions/dashboard"},
    {"$ref": "#/definitions/page"},
    {"$ref": "#/definitions/widget"}
  ],
  "definitions": {
    "dashboard": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"const": "dashboard"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "permissions": {"type": "string", "enum": ["PUBLIC_READ_WRITE", "PUBLIC_READ_ONLY", "PRIVATE"]},
        "pages": {
          "type": "array",
          "items": {"$ref": "#/definitions/pageBody"}
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"const": "page"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "widgets": {
          "type": "array",
          "items": {"$ref": "#/definitions/widgetBody"}
        }
      },
      "additionalProperties": false
    },
    "widget": {
      "type": "object",
      "required": ["kind", "title"],
      "properties": {
        "kind": {"const": "widget"},
        "title": {"type": "string", "minLength": 1},
        "visualization": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "properties": {
            "row": {"type": "integer", "minimum": 1},
            "column": {"type": "integer", "minimum": 1},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "row": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "configuration": {"type": "object"},
        "rawConfiguration": {
          "anyOf": [
            {"type": "string"},
            {"type": "object"}
          ]
        },
        "linkedEntityGuids": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "pageBody": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "widgets": {
          "type": "array",
          "items": {"$ref": "#/definitions/widgetBody"}
        }
      },
      "additionalProperties": false
    },
    "widgetBody": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "visualization": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "properties": {
            "row": {"type": "integer", "minimum": 1},
            "column": {"type": "integer", "minimum": 1},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "row": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "configuration": {"type": "object"},
        "rawConfiguration": {
          "anyOf": [
            {"type": "string"},
            {"type": "object"}
          ]
        },
        "linkedEntityGuids": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  }
}
