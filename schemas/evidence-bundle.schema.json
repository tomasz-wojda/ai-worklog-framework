{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnostic Evidence Bundle",
  "type": "object",
  "required": ["pack", "timestamp", "parameters", "status", "steps"],
  "properties": {
    "pack": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "parameters": {"type": "object"},
    "status": {"type": "string", "enum": ["success", "degraded", "blocked", "error"]},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "exit_code", "duration_ms", "stdout", "stderr"],
        "properties": {
          "id": {"type": "string"},
          "command": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "duration_ms": {"type": "integer"},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
