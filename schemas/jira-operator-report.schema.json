{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jira Operator Report",
  "type": "object",
  "required": ["operation", "fetched_at", "status", "items"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "ticket", "summary", "rejected", "reporter", "tempo", "verify", "whoami", "log-time",
        "assets-schemas", "assets-types", "assets-attributes", "assets-object", "assets-search",
        "get-ci", "get-cis"
      ]
    },
    "fetched_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["ready", "degraded", "blocked", "error", "unknown"]
    },
    "message": {"type": "string"},
    "error_kind": {"type": "string", "enum": ["user", "system"]},
    "ticket_key": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "reporter": {"type": "string"},
    "object_key": {"type": "string"},
    "query": {"type": "string"},
    "env": {"type": "string"},
    "schema_id": {"type": "integer"},
    "type_id": {"type": "integer"},
    "dry_run": {"type": "boolean"},
    "applied": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "totals": {"type": "object"},
    "items": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
