{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jenkins Operator Report",
  "type": "object",
  "required": ["operation", "fetched_at", "status", "items"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["controllers", "health", "job", "plugins", "credentials", "seed", "syntax-check"]
    },
    "fetched_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["ready", "degraded", "blocked", "error", "unknown"]
    },
    "controller": {"type": "string"},
    "message": {"type": "string"},
    "domain": {"type": "string"},
    "required": {
      "type": "object",
      "properties": {
        "requested": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "inactive": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
