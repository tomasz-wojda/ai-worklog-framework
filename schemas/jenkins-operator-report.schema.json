{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jenkins Operator Report",
  "type": "object",
  "required": ["operation", "fetched_at", "status", "items"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "controllers",
        "health",
        "job",
        "plugins",
        "plugin-vulnerabilities",
        "credentials",
        "seed",
        "syntax-check",
        "nodes",
        "queue",
        "jobs",
        "artifacts",
        "download-artifact",
        "job-export",
        "run-script",
        "plugin-install",
        "safe-restart",
        "views",
        "whoami",
        "credential-domains"
      ]
    },
    "fetched_at": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["ready", "degraded", "blocked", "error", "unknown"]
    },
    "controller": {"type": "string"},
    "message": {"type": "string"},
    "domain": {"type": "string"},
    "folder": {"type": "string"},
    "query": {"type": "string"},
    "view": {"type": "string"},
    "job": {"type": "string"},
    "build_selector": {"type": "string"},
    "core_version": {"type": "string"},
    "update_center": {
      "type": "object",
      "properties": {
        "url": {"type": "string"},
        "generated_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "properties": {
        "requested": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["requested", "missing"],
      "additionalProperties": false
    },
    "enrichment": {
      "type": "object",
      "properties": {
        "requested": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["requested", "errors"],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "installed": {"type": "integer", "minimum": 0},
        "scanned": {"type": "integer", "minimum": 0},
        "affected": {"type": "integer", "minimum": 0},
        "REMEDIABLE": {"type": "integer", "minimum": 0},
        "UNFIXABLE": {"type": "integer", "minimum": 0},
        "BLOCKED": {"type": "integer", "minimum": 0}
      },
      "required": ["installed", "scanned", "affected", "REMEDIABLE", "UNFIXABLE", "BLOCKED"],
      "additionalProperties": false
    },
    "required": {
      "type": "object",
      "properties": {
        "requested": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "inactive": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
