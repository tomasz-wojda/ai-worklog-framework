{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Automox Operator Config",
  "type": "object",
  "properties": {
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "mutation_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "api_base_url": {"type": "string", "format": "uri"},
    "org": {"type": "string"},
    "domain": {"type": "string"},
    "default_profile": {"type": "string"},
    "devices_limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "groups_limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "policies_limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "packages_limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "activity_limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "patch_summary_limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "queue_limit": {"type": "integer", "minimum": 1, "maximum": 200},
    "history_max": {"type": "integer", "minimum": 1, "maximum": 50000},
    "polling_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "polling_max_wait_seconds": {"type": "integer", "minimum": 1, "maximum": 900}
  },
  "additionalProperties": false
}
