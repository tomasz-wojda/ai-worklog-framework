{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Worklog Command Contract",
  "definitions": {
    "value": {
      "type": "object",
      "required": ["help_values"],
      "properties": {
        "choices": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "pattern": {"type": "string"},
        "integer_min": {"type": "integer"},
        "integer_max": {"type": "integer"},
        "help_values": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "positional": {
      "type": "object",
      "required": ["name", "description", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "variadic": {"type": "boolean"},
        "value": {"$ref": "#/definitions/value"}
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["name", "description", "takes_value"],
      "properties": {
        "name": {"type": "string", "pattern": "^--[a-z0-9][a-z0-9-]*$"},
        "short": {"type": "string", "pattern": "^-[A-Za-z0-9]$"},
        "description": {"type": "string", "minLength": 1},
        "takes_value": {"type": "boolean"},
        "repeatable": {"type": "boolean"},
        "default_from": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/definitions/value"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["name", "description", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["command", "service", "action"]
        },
        "subcommands": {
          "type": "array",
          "items": {"$ref": "#/definitions/node"}
        },
        "positionals": {
          "type": "array",
          "items": {"$ref": "#/definitions/positional"}
        },
        "options": {
          "type": "array",
          "items": {"$ref": "#/definitions/option"}
        }
      },
      "oneOf": [
        {
          "required": ["subcommands"],
          "not": {
            "anyOf": [
              {"required": ["positionals"]},
              {"required": ["options"]}
            ]
          }
        },
        {
          "required": ["positionals", "options"],
          "not": {"required": ["subcommands"]}
        }
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["version", "program", "description", "global_options", "commands"],
      "properties": {
        "version": {"type": "integer", "const": 2},
        "program": {"type": "string", "const": "ai-worklog"},
        "description": {"type": "string", "minLength": 1},
        "global_options": {
          "type": "array",
          "items": {"$ref": "#/definitions/option"}
        },
        "commands": {
          "type": "array",
          "items": {"$ref": "#/definitions/node"},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "version": {"type": "integer", "const": 2},
        "node": {"$ref": "#/definitions/node"}
      },
      "required": ["version", "node"],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/contract"},
    {"$ref": "#/definitions/description"}
  ]
}
